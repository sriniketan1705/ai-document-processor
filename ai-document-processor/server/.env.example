# ---- Server ----
PORT=5000
CLIENT_URL=http://localhost:5173

# ---- MongoDB ----
# Local:  mongodb://127.0.0.1:27017/idp
# Atlas:  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/idp
MONGO_URI=mongodb://127.0.0.1:27017/idp

# ---- Auth ----
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ---- Uploads ----
MAX_FILE_SIZE_MB=10
# Optional: folder that contains eng.traineddata (only for offline OCR). Leave empty normally.
TESSERACT_LANG_PATH=

# ---- AI (choose one: gemini | anthropic | none) ----
# "none" = no API key needed, uses the built-in simple summarizer (good for first run / demo)
AI_PROVIDER=none

# Gemini (free tier available at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic (Claude) - https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
